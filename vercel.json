{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://cryptoscope-backend-ny9o.onrender.com/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://cryptoscope-backend-ny9o.onrender.com/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
